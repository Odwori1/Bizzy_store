{
  "name": "bizzy-pos-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Modern Point of Sale System",
  "author": "Bizzy POS Team",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder build --dir",
    "electron:dist": "npm run build && electron-builder build",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:apk": "npx cap sync android && cd android && ./gradlew bundleRelease",
    "desktop:all": "npm run electron:dist",
    "mobile:android": "npm run android:apk"
  },
  "build": {
    "appId": "com.bizzy.pos",
    "productName": "Bizzy POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "dist/pwa-256x256.png"
    },
    "win": {
      "target": "nsis",
      "icon": "dist/pwa-256x256.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@hookform/resolvers": "^3.3.1",
    "@tanstack/react-query": "^4.29.7",
    "axios": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-router-dom": "^6.8.1",
    "react-webcam": "^7.2.0",
    "recharts": "^2.1.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^0.34.0"
  }
}
